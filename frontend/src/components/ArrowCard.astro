---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"guides"> | CollectionEntry<"articles">;
};

const { entry } = Astro.props;
if (!entry) {
  throw new Error("Entry is null or undefined");
}
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="card group relative flex flex-nowrap items-center gap-4 py-4 pl-5 pr-12"
>
  <div class="flex flex-col flex-1 truncate">
    <div
      class="truncate text-base font-semibold text-ink transition-colors group-hover:text-primary-ink"
    >
      {entry.data.title}
    </div>
    <div class="mt-1 line-clamp-2 text-sm text-muted">
      {entry.data.description}
    </div>
  </div>
  <div class="absolute right-5 top-1/2 -translate-y-1/2">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="size-5 fill-none stroke-2 stroke-muted transition-all duration-300 group-hover:stroke-primary-ink"
    >
      <line
        x1="5"
        y1="12"
        x2="19"
        y2="12"
        class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"
      ></line>
      <polyline
        points="12 5 19 12 12 19"
        class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-out"
      ></polyline>
    </svg>
  </div>
</a>
