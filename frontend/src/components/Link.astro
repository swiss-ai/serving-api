---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
}

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block text-current decoration-line-strong transition-colors duration-200 hover:text-primary-ink hover:decoration-primary-ink", underline && "underline underline-offset-2", className)}
  {...rest}>
  <slot/>
</a>
