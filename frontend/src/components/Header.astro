---
import SlackIcon from "@components/SlackIcon.astro";
import { SITE } from "@consts";
import NavMenus from "@components/NavMenus.svelte";
import { getActiveSession } from '@lib/activeSession';
import { endSessionConfig } from '@lib/endSession';

// Sessions are auth-astro cookies resolved during SSR; local dev signs in
// through the compose Authentik — there is no bypass.
let session: any = null;
try {
  session = await getActiveSession(Astro.request);
} catch {
  session = null;
}

// Admin status lives in our database, not the IdP claims, so it needs a
// lookup. Short timeout and a safe default: a slow or unhappy API costs the
// menu, never the page.
let isAdmin = false;
if (session?.accessToken) {
  try {
    const apiBase =
      process.env.VITE_API_URL ||
      import.meta.env.VITE_API_URL ||
      "https://api.swissai.svc.cscs.ch";
    const res = await fetch(`${apiBase}/v1/profile`, {
      headers: { Authorization: `Bearer ${session.accessToken}` },
      signal: AbortSignal.timeout(3000),
    });
    if (res.ok) isAdmin = !!(await res.json()).is_admin;
  } catch {
    isAdmin = false;
  }
}
const signedIn = !!session;
const userEmail = session?.user?.email || '';
const endSession = await endSessionConfig(session);

// The nav marks the section you are in (.nav-link[aria-current]).
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const primaryLinks = [
  { href: "/leaderboard", label: "Leaderboard" },
  { href: "/performance", label: "Performance" },
];
const HELP_URL = "https://swissai-initiative.slack.com/archives/C07DHJFRE2X";
---

<header class="site-header">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3 md:px-8">
    <a href="/" class="text-lg font-bold tracking-tight text-primary-ink no-underline md:text-[1.4rem]">
      {SITE.NAME}
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      <div class="flex items-center gap-6">
        {primaryLinks.map((link) => (
          <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
        <NavMenus client:load signedIn={signedIn} isAdmin={isAdmin} email={userEmail} currentPath={path} section="about" />
        <a href={HELP_URL} target="_blank" rel="noopener noreferrer" class="nav-link">
          <SlackIcon class="size-3.5" />
          Get Help
        </a>
      </div>
      <NavMenus client:load signedIn={signedIn} isAdmin={isAdmin} email={userEmail} endSession={endSession} currentPath={path} section="profile" />
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      class="btn btn-ghost px-2 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-line px-4 pb-4 pt-3 md:hidden" aria-label="Main">
    {primaryLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isCurrent(link.href) ? "page" : undefined}
        class="py-1.5 text-sm font-medium text-ink hover:text-primary-ink aria-[current=page]:text-primary-ink"
      >
        {link.label}
      </a>
    ))}
    <NavMenus client:load signedIn={signedIn} isAdmin={isAdmin} email={userEmail} endSession={endSession} currentPath={path} mobile={true} />
    <a href={HELP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-2 w-fit">
      <SlackIcon class="size-3.5" />
      Get Help
    </a>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuButton && mobileMenu && hamburgerIcon && closeIcon) {
    mobileMenuButton.addEventListener('click', () => {
      const opening = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', !opening);
      mobileMenu.classList.toggle('flex', opening);
      hamburgerIcon.classList.toggle('hidden', opening);
      closeIcon.classList.toggle('hidden', !opening);
      mobileMenuButton.setAttribute('aria-expanded', String(opening));
    });
  }
</script>
