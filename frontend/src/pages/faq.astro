---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";

export const prerender = false;

const faqs = [
  {
    q: "What is the SwissAI Research Platform?",
    a: 'An LLM inference service for the academic community, built as part of the Apertus project. It gives you an OpenAI-compatible API and a Chat interface for <a class="text-indigo-600 dark:text-indigo-400 underline" href="/all_models">models hosted</a> on Swiss infrastructure — and, with a compute grant, lets you launch and serve your own models on CSCS Alps via Slurm or Kubernetes.',
  },
  {
    q: "Why did you make this?",
    a: 'We built this service for research purposes as part of the <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org" target="_blank" rel="noopener noreferrer">Apertus project</a> — while building our own models, we also needed a place to test and run them. Opening that platform up lets the wider academic community use it too.',
  },
  {
    q: "What is different about the SwissAI Research Platform?",
    a: 'We can host models on both Slurm <em>and</em> Kubernetes — a combination that is unique to this platform, made possible by <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://www.usenix.org/conference/osdi26/presentation/yao" target="_blank" rel="noopener noreferrer">OpenTela</a> routing. That means the same OpenAI-compatible API can serve models from batch-style GPU allocations on CSCS Alps as well as always-on Kubernetes deployments.',
  },
  {
    q: "What repos make this service?",
    a: '<ul class="list-disc pl-8 space-y-2"><li><a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/eth-easl/OpenTela" target="_blank" rel="noopener noreferrer">OpenTela</a> — the decentralized compute fabric that routes requests to models wherever they run (we deploy from a <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/opentela" target="_blank" rel="noopener noreferrer">swiss-ai fork</a>).</li><li><a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/serving-api" target="_blank" rel="noopener noreferrer">serving-api</a> — this website: the API gateway, budgets and the frontend.</li><li><a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/model-launch" target="_blank" rel="noopener noreferrer">model-launch</a> — tooling to launch and serve your own models on Slurm.</li><li>infra — infrastructure and ArgoCD deployment configs (private).</li></ul>',
  },
  {
    q: "What are providers?",
    a: 'Providers are external inference platforms we have a partnership with. We route requests through our <a class="text-indigo-600 dark:text-indigo-400 underline" href="/">SwissAI Research</a> platform to them, so you can reach their models with the same API key and OpenAI-compatible API you already use here. All current providers are Swiss universities, so access remains academic. Requests to external providers are currently rate-limited to 15 requests per minute per user.',
  },
  {
    q: "I want to use LLMs, what options are available?",
    a: '(0) <a class="text-indigo-600 dark:text-indigo-400 underline" href="/">SwissAI Research</a> (this website) — hosted models via the OpenAI-compatible API and the Chat app; see the <a class="text-indigo-600 dark:text-indigo-400 underline" href="/all_models">models list</a>.<br /><br />(1) <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://docs.cscs.ch/services/inference/" target="_blank" rel="noopener noreferrer">CSCS Inference</a> — a curated list of always-on models with production-grade autoscaling.<br /><br />(2) <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://www.epfl.ch/research/facilities/rcp/ai-inference-as-a-service/" target="_blank" rel="noopener noreferrer">EPFL RCP AIaaS</a> — curated models on the EPFL RCP cluster. <br /> <br /> All of these have models that change over time.',
  },
  {
    q: "I want to run my own LLM, what options are available?",
    a: 'On <a class="text-indigo-600 dark:text-indigo-400 underline" href="/">SwissAI Research</a>: <ul class="list-disc pl-8 mt-2 mb-2"><li>Slurm, via <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/model-launch" target="_blank" rel="noopener noreferrer">model launch</a> — the standard route, using your CSCS GPU grant.</li><li>Kubernetes — in special circumstances; please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a>.</li></ul>See <a class="text-indigo-600 dark:text-indigo-400 underline" href="#how-do-i-launch-my-own-models">How do I launch my own models?</a> below for the details.',
  },
  {
    q: "When should I use each?",
    a: '<ul class="list-disc pl-8 space-y-2"><li><strong>Models already listed here</strong> — the default choice for everyday API and Chat use; no setup, no grant needed.</li><li><strong>Slurm via model launch</strong> — when you need high throughput or want to batch-process large amounts of data, or when we don\'t host the model or configuration you need. Requires a CSCS GPU grant.</li><li><strong>Kubernetes</strong> — special cases that need an always-on, production-style deployment; <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a> to discuss.</li><li><strong>CSCS Inference</strong> — when you want a stable, production-grade endpoint for one of their curated models and the rate limits here are too tight.</li><li><strong>EPFL RCP AIaaS</strong> — when you are EPFL-affiliated or their curated model list fits your needs.</li></ul>',
  },
  {
    q: "What if the provider rate limits are not enough?",
    a: 'You have two options: <br /><br />(1) Use <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/model-launch" target="_blank" rel="noopener noreferrer">model launch</a> to launch your own model — we recommend this if you want to process large amounts of data in batch and need high throughput. <br />(2) Go directly to the provider and request access with them.',
  },
  {
    q: "Why do you route to providers instead of hosting everything yourself?",
    a: 'Often the same models are already hosted by a provider (for example on CSCS), so hosting them twice would waste GPU resources. Routing also adds resiliency: if CSCS has an outage, traffic can still be served via RCP.',
  },
  {
    q: "What is the tech stack behind a provider?",
    a: 'It is best to ask the provider directly, as their stack may change over time — see the provider links above for their documentation and contact details.',
  },
  {
    q: "Can I use this in my project?",
    a: "Yes, as long as it's an academic project, we should be able to grant you access.",
  },
  {
    q: "Can I use this for commercial or startup use?",
    a: 'No, this is for non-commercial use only. Please reach out at <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">apertus-ai.org/contact/</a>, including some details and we will forward your request to the right internal team or industry partners',
  },
  {
    q: "Can I launch any model?",
    a: 'Yes, see <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/model-launch" target="_blank" rel="noopener noreferrer">model launch</a>. This usually requires a CSCS GPU grant. Compute grants come in two tiers: small (&lt;32k GPU hrs) and large (&gt;500k GPU hrs). See the <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://www.swiss-ai.org/compute-grants" target="_blank" rel="noopener noreferrer">compute grants process</a>.',
  },
  {
    q: "How do I launch my own models?",
    a: 'Use <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://github.com/swiss-ai/model-launch" target="_blank" rel="noopener noreferrer">model launch</a> — a framework-agnostic tool that submits Slurm jobs for distributed inference with vLLM or SGLang on CSCS Alps, for single- or multi-node deployments. It registers your model with OpenTela automatically, so it becomes reachable through this platform\'s API and appears under your username. You need a CSCS GPU grant (see the previous question). Start with the <a class="text-indigo-600 dark:text-indigo-400 underline" href="/guides/01-getting-started/model-launch">model launch guide</a>, then the repository\'s examples for popular models.',
  },
  {
    q: "Is my institution enabled?",
    a: 'Every account gets an active budget on its first sign-in. If you cannot sign in, or your account shows as inactive, please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a>.',
  },
  {
    q: "I'm at a non-Swiss university, can I get access?",
    a: "Yes, but service is prioritised in this order: <br /><br />(1) ETH and EPFL Apertus-related projects, <br />(2) Swiss AI-related institutions, <br />(3) other global academic institutions.",
  },
  {
    q: "I don't have an account at one of the supported universities. How do I get access?",
    a: 'Sign-in offers only the Swiss university accounts we federate with, so there is no way to register yourself — a Google, GitHub or ORCID identity is turned away. Instead, post a short description of your project and who you are working with in the <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://swissai-initiative.slack.com/archives/C07DHJFRE2X" target="_blank" rel="noopener noreferrer">Swiss AI Serving Slack channel</a>. If we can support it, we will email you a single-use invitation link; you choose a name and password on it and arrive signed in, with a key waiting on the <a class="text-indigo-600 dark:text-indigo-400 underline" href="/api_key">API key page</a>.<br /><br />We will also send you a sign-in page to bookmark for later visits. The <strong>Sign in</strong> button on this site only offers the university accounts, so it is not the way back into an invited account.',
  },
  {
    q: "Can I get access as a guest or external collaborator?",
    a: 'Yes. Guest accounts are added manually by our team, so please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a> with a short description of your project and who you are working with at a supported institution.',
  },
  {
    q: "I'm running a hackathon or sprint, can we get access?",
    a: 'Possibly. If it\'s academic and focused on Apertus, please reach out at <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">apertus-ai.org/contact/</a>.',
  },
  {
    q: "I can't access the Chat because I'm not on the network. What can I do?",
    a: 'If you have API access, try running Open WebUI locally: see the <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://serving.swissai.svc.cscs.ch/guides/01-getting-started/openwebui" target="_blank" rel="noopener noreferrer">Open WebUI guide</a>. Otherwise, we can whitelist your institution or VPN IP range; please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a>.',
  },
  {
    q: "I would like to collaborate on an academic project, is this possible?",
    a: 'Please reach out at <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">apertus-ai.org/contact/</a>.',
  },
  {
    q: "Do you store my prompts and responses?",
    a: 'For the <strong>API</strong>: no. We do not store prompt or response content. We keep only metadata logs (e.g. userid, input/output token counts, model, timestamp) for capacity planning and abuse prevention.<br /><br />For the internal facing <strong>Chat app</strong>: yes, your conversation history is retained so you can return to past chats. This is important for the Apertus team development and testing various model types. Your chats are not extracted and used for training. To request deletion of your chat history, please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a>.',
  },
  {
    q: "Do you train models on my data?",
    a: "No. We do not use your prompts or responses to train or fine-tune models. All data used to train Apertus data has strict data standards. ",
  },
  {
    q: "How long do you retain data?",
    a: 'API metadata logs (token counts, model, timestamp) are kept indefinitely for operations and abuse prevention. Individual chat history is retained until you delete it via OpenWebUI settings or you delete your account, to do this please contact us. For specific data retention questions, please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a>.',
  },
  {
    q: "For the Chat application, where is my data processed and stored?",
    a: 'The platform runs on Swiss infrastructure (CSCS) which is based in Lugano. This includes the entire application, including the web application, API, database and storage.',
  },
  {
    q: "Can I send personal, confidential, or sensitive data?",
    a: 'Do not send personal, confidential, or otherwise sensitive data (e.g. personally identifiable information). The platform is a research service and is not intended for processing such data. If your project has specific data-protection requirements (FADP/GDPR), please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a> first.',
  },
  {
    q: "What models are available?",
    a: 'You can list the currently available models on the webpage or via the <code>/v1/models</code> endpoint, or pick from the model selector in the Chat app.',
  },
  {
    q: "Are there rate limits or usage budgets?",
    a: 'Yes. Each user/institution has a usage budget, and requests may be rate-limited to keep the service fair and available. A <strong>low request rate</strong> is currently under 15 requests per minute per user for provider-routed models, and slightly higher for models served directly on the SwissAI platform. If you need a higher limit for a project, please <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">contact us</a>.',
  },
  {
    q: "How do I get or reset my API key?",
    a: 'You can create and reset your key on the <a class="text-indigo-600 dark:text-indigo-400 underline" href="/api_key">API key page</a>. Currently there is only 1 API key available per user.',
  },
  {
    q: "Can I use OpenAI-compatible tools and SDKs?",
    a: 'Yes. The API is OpenAI-compatible, so it works with the OpenAI SDKs, LangChain, Open WebUI and similar tools — just point the base URL at our endpoint (<code>.../v1</code>) and use your API key.',
  },
  {
    q: "How should I cite or refer to the service in a paper, proposal, or other document?",
    a: `Please refer to the service as <strong>Swiss AI Serving</strong> and cite the OpenTela project that powers it using the following BibTeX entry:
<pre class="mt-3 whitespace-pre-wrap break-words text-sm font-mono"><code>@inproceedings{318577,
  author = {Xiaozhe Yao and Youhe Jiang and Ilia Badanin and Qinghao Hu and Robert Matthew Smith and Binhang Yuan and Imanol Schlag and Eiko Yoneki and Ana Klimovic},
  title = {{OpenTela}: Unifying Decentralized Computing Resources for Heterogeneous {LLM} Serving (Operational Systems)},
  booktitle = {20th USENIX Symposium on Operating Systems Design and Implementation (OSDI 26)},
  year = {2026},
  isbn = {978-1-939133-55-7},
  address = {Seattle, WA},
  pages = {1821--1838},
  url = {https://www.usenix.org/conference/osdi26/presentation/yao},
  publisher = {USENIX Association},
  month = jul
}</code></pre>`,
  },
  {
    q: "How do I contact you?",
    a: '(1) <strong>Community Slack</strong> — the <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://swissai-initiative.slack.com/archives/C07DHJFRE2X" target="_blank" rel="noopener noreferrer">SwissAI Initiative Slack</a> is the fastest way to reach us and the community (requires a SwissAI Initiative account).<br /><br />(2) <strong>Contact form</strong> — for everything else, reach out via <a class="text-indigo-600 dark:text-indigo-400 underline" href="https://apertus-ai.org/contact/" target="_blank" rel="noopener noreferrer">apertus-ai.org/contact/</a>.',
  },
];

// Anchor id per question, so entries are deep-linkable (/faq#what-are-providers)
// and the flowchart can point at them.
const slug = (q: string) =>
  q.toLowerCase().replace(/[^a-z0-9\s-]/g, "").trim().replace(/\s+/g, "-");
---

<PageLayout title="FAQ" description="Frequently asked questions about the Swiss AI Research Platform">
  <Container>
    <div class="space-y-12 py-8">
      <div class="animate text-center">
        <h1 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Common questions about access and use of the Swiss AI Platform
        </p>
      </div>

      <div class="space-y-6">
        {faqs.map((faq, i) => (
          <>
            <div class="animate card p-8">
              <h2 id={slug(faq.q)} class="scroll-mt-24 text-xl font-bold text-slate-900 dark:text-white mb-3">
                {faq.q}
              </h2>
              <div
                class="faq-answer text-slate-600 dark:text-slate-300 leading-relaxed min-w-0 [&_pre]:whitespace-pre-wrap [&_pre]:break-words"
                set:html={faq.a}
              />
            </div>
            {i === 0 && (
          <div class="animate card p-8">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
              Which option should I use?
            </h2>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-2">
              Follow the questions below to find the best fit for your use case. Valid for academic use only:
            </p>
            <div class="overflow-x-auto">
              <svg
                viewBox="0 0 1140 560"
                class="min-w-[760px] w-full h-auto"
                role="img"
                aria-label="Decision flowchart with Yes/No branches linking to model launch on Slurm, compute grants, CSCS Inference, and contact options."
              >
                <g stroke-width="2" fill="none" stroke-linejoin="round">
                  <path class="stroke-emerald-500" d="M465,110 V145 H180 V172" />
                  <path class="stroke-rose-400" d="M465,110 V145 H750 V172" />
                  <path class="stroke-emerald-500" d="M180,250 V285 H85 V312" />
                  <path class="stroke-rose-400" d="M180,250 V285 H275 V312" />
                  <path class="stroke-emerald-500" d="M750,250 V285 H560 V312" />
                  <path class="stroke-rose-400" d="M750,250 V285 H940 V312" />
                  <path class="stroke-emerald-500" d="M560,396 V430 H465 V462" />
                  <path class="stroke-rose-400" d="M560,396 V430 H655 V462" />
                  <path class="stroke-emerald-500" d="M940,396 V430 H845 V462" />
                  <path class="stroke-rose-400" d="M940,396 V430 H1035 V462" />
                </g>
                <g>
                  <path class="fill-emerald-500" d="M174,171 h12 l-6,9 z" />
                  <path class="fill-rose-400" d="M744,171 h12 l-6,9 z" />
                  <path class="fill-emerald-500" d="M79,311 h12 l-6,9 z" />
                  <path class="fill-rose-400" d="M269,311 h12 l-6,9 z" />
                  <path class="fill-emerald-500" d="M554,311 h12 l-6,9 z" />
                  <path class="fill-rose-400" d="M934,311 h12 l-6,9 z" />
                  <path class="fill-emerald-500" d="M459,461 h12 l-6,9 z" />
                  <path class="fill-rose-400" d="M649,461 h12 l-6,9 z" />
                  <path class="fill-emerald-500" d="M839,461 h12 l-6,9 z" />
                  <path class="fill-rose-400" d="M1029,461 h12 l-6,9 z" />
                </g>
                <g font-size="12" font-weight="700" text-anchor="middle">
                  <text class="fill-emerald-600 dark:fill-emerald-400" x="322" y="140">Yes</text>
                  <text class="fill-rose-500 dark:fill-rose-400" x="607" y="140">No</text>
                  <text class="fill-emerald-600 dark:fill-emerald-400" x="132" y="280">Yes</text>
                  <text class="fill-rose-500 dark:fill-rose-400" x="228" y="280">No</text>
                  <text class="fill-emerald-600 dark:fill-emerald-400" x="655" y="280">Yes</text>
                  <text class="fill-rose-500 dark:fill-rose-400" x="846" y="280">No</text>
                  <text class="fill-emerald-600 dark:fill-emerald-400" x="512" y="425">Yes</text>
                  <text class="fill-rose-500 dark:fill-rose-400" x="608" y="425">No</text>
                  <text class="fill-emerald-600 dark:fill-emerald-400" x="892" y="425">Yes</text>
                  <text class="fill-rose-500 dark:fill-rose-400" x="988" y="425">No</text>
                </g>
                <g class="stroke-slate-300 dark:stroke-slate-500" stroke-width="1">
                  <rect class="fill-slate-100 dark:fill-slate-700" x="315" y="20" width="300" height="90" rx="10" />
                  <rect class="fill-slate-100 dark:fill-slate-700" x="50" y="180" width="260" height="70" rx="10" />
                  <rect class="fill-slate-100 dark:fill-slate-700" x="590" y="180" width="320" height="70" rx="10" />
                  <rect class="fill-slate-100 dark:fill-slate-700" x="440" y="320" width="240" height="76" rx="10" />
                  <rect class="fill-slate-100 dark:fill-slate-700" x="820" y="320" width="240" height="76" rx="10" />
                </g>
                <g font-size="15" font-weight="600" text-anchor="middle" class="fill-slate-900 dark:fill-white">
                  <text x="465" y="47">Process or generate huge amounts</text>
                  <text x="465" y="67">of data (e.g. in a batch)</text>
                  <text x="465" y="87">as fast as possible?</text>
                  <text x="180" y="208">Do you have a CSCS grant</text>
                  <text x="180" y="228">or project with compute?</text>
                  <text x="750" y="208">Individual chat, RAG or agentic usecases?</text>
                  <a href="#are-there-rate-limits-or-usage-budgets" class="group">
                    <title>Currently under 15 requests/minute for provider models, slightly higher for platform-served models — click for details.</title>
                    <text x="750" y="228" class="group-hover:underline">(low request rate)</text>
                    <line x1="687" y1="233" x2="813" y2="233" stroke-width="1.5" stroke-dasharray="2 3" class="stroke-slate-500 dark:stroke-slate-400 group-hover:opacity-0" />
                  </a>
                  <text x="560" y="351">Is the model already</text>
                  <text x="560" y="371">hosted here or via a provider?</text>
                  <text x="940" y="351">Need a production-grade,</text>
                  <text x="940" y="371">always-on endpoint?</text>
                </g>
                <a href="#how-do-i-launch-my-own-models" class="hover:opacity-75">
                  <title>How to launch your own models — see FAQ below.</title>
                  <rect class="fill-emerald-100 dark:fill-emerald-900 stroke-emerald-400" x="1" y="320" width="168" height="76" rx="8" />
                  <text font-size="13" font-weight="600" text-anchor="middle" class="fill-emerald-800 dark:fill-emerald-200" x="85" y="349">Use SwissAI Research</text>
                  <text font-size="13" text-anchor="middle" class="fill-emerald-700 dark:fill-emerald-300" x="85" y="369">model launch on Slurm</text>
                  <text font-size="13" font-weight="600" text-anchor="end" class="fill-emerald-700 dark:fill-emerald-300" x="161" y="336">↓</text>
                </a>
                <a href="#can-i-launch-any-model" class="hover:opacity-75">
                  <title>Compute grant tiers and process — see FAQ below.</title>
                  <rect class="fill-slate-100 dark:fill-slate-700 stroke-slate-300 dark:stroke-slate-500" x="191" y="320" width="168" height="76" rx="8" />
                  <text font-size="13" font-weight="600" text-anchor="middle" class="fill-slate-700 dark:fill-slate-200" x="275" y="339">Apply for a compute</text>
                  <text font-size="13" text-anchor="middle" class="fill-slate-600 dark:fill-slate-300" x="275" y="359">grant, or go directly</text>
                  <text font-size="13" text-anchor="middle" class="fill-slate-600 dark:fill-slate-300" x="275" y="379">to a provider</text>
                  <text font-size="13" font-weight="600" text-anchor="end" class="fill-slate-500 dark:fill-slate-400" x="351" y="336">↓</text>
                </a>
