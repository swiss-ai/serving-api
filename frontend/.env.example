# Copy this to frontend/.env. The Makefile does it automatically.
#
# Only VITE_-prefixed vars are visible to the Astro/Vite frontend; do
# NOT paste backend secrets (DATABASE_URL, AUTH0_CLIENT_SECRET, Neon
# URLs, etc.) here — those go in the project-root .env or
# rob-poc/serving-api/{dev,prod}/secrets.yaml only.

# API the frontend talks to. Must be localhost during local dev so
# `make run` / `make dummy-run` hit your own backend instead of prod.
# The Makefile's _guard-local-api refuses non-local values.
VITE_API_URL=http://localhost:8080

# Authentik OIDC client (CILogon federation, issue #44). Var names stay
# VITE_AUTH0_* for now but hold Authentik values. Safe to commit since they're
# public client identifiers. Only a build-time fallback — the active provider
# and its runtime issuer/client come from AUTH_PROVIDER + AUTH0_*/AUTHENTIK_*
# in the project-root .env / deployment configmap (issue #58).
VITE_AUTH0_CLIENT_ID=REPLACE_WITH_VITE_AUTH0_CLIENT_ID
VITE_AUTH0_DOMAIN=auth.swissai.svc.cscs.ch

# ── Auth (server-side, read by auth.config.ts via loadEnv) ──────────────────
# auth-astro resolves its provider config from THIS file (plus process.env),
# not the project-root .env — that one only feeds the backend. These defaults
# match the local Authentik from `make idp-up` (authentik-local/blueprint.yaml);
# sign in as admin@localhost / admin. All values are LOCAL ONLY.
AUTH_PROVIDER=authentik
AUTHENTIK_ISSUER=http://localhost:9000/application/o/serving-api-local/
AUTHENTIK_CLIENT_ID=serving-api-local
AUTHENTIK_CLIENT_SECRET=local-dev-secret-not-for-deployment
AUTH_SECRET=local-dev-auth-secret-32-chars-min-ok
AUTH_TRUST_HOST=true
