# Direct dependencies. Edit this file, then run `make lock` to regenerate
# requirements.txt, the pinned lockfile that CI, the Docker image and local
# installs all use. Never install from this file directly: an unpinned
# resolve at image build time is how sqlmodel 0.0.46 reached prod untested.
fastapi
uvicorn
httpx
python-dotenv
pydantic
loguru
aiohttp
async-lru
backoff
langfuse
openai
# ==0.0.46 matches prod. From 0.0.45 a plain `datetime` field is UTCDateTime
# and rejects naive values at insert. Timestamp columns use pydantic
# NaiveDatetime (DateTime(timezone=False)), so this pin keeps that check in
# CI and the image. sqlmodel<0.0.45 hides the bug; do not restore it.
sqlmodel==0.0.46
psycopg2-binary
pyjwt[crypto]
pydantic-settings
redis
hiredis
alembic
# Imported directly; previously only present transitively.
requests
cachetools
sqlalchemy
